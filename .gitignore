# ============================================================
# Brand-Core .gitignore
# Django (Backend) + Next.js (Frontend) + Docker
# ============================================================

# -----------------------------------------------
# Environment Variables
# -----------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# -----------------------------------------------
# Python / Django
# -----------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
eggs/
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
.venv/
ENV/

# Django
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
backend/staticfiles/
backend/mediafiles/
backend/media/

# Celery (future)
celerybeat-schedule
celerybeat.pid

# -----------------------------------------------
# Node.js / Next.js
# -----------------------------------------------
node_modules/
.next/
out/
frontend/.next/
frontend/out/
frontend/node_modules/

# Build
frontend/.vercel
frontend/.turbo

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# -----------------------------------------------
# IDE / Editor
# -----------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -----------------------------------------------
# Docker
# -----------------------------------------------
docker-compose.override.yml

# -----------------------------------------------
# OS
# -----------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

